# ==========================================================================
# Antero Cartas — variáveis de ambiente (exemplo)
#
# Copie para .env.local:
#   cp .env.example .env.local
#
# Os valores abaixo já funcionam para DESENVOLVIMENTO LOCAL depois de rodar
# `npx supabase start` (ver README e docs/0004_Decisions.md — Fase 2.5).
# Para produção, os valores reais ficam só nas variáveis de ambiente da
# Vercel — nunca neste arquivo nem em .env.local.
# ==========================================================================

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

# Marcador explícito do ambiente: "local" (dev) | "production" | "test".
# Usado por src/lib/appEnv.ts para impedir que credenciais de produção sejam
# usadas sem querer num servidor `next dev` (ver D49 em docs/0004_Decisions.md).
APP_ENV=local

# URL canônica do site (metadata/SEO/sitemap/canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL base para montar o link público da carta e o QR Code.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Número (DDI+DDD, só dígitos) usado nos links de ajuda por WhatsApp.
NEXT_PUBLIC_WHATSAPP_SUPPORT=5599999999999

# Assistente de escrita com IA (LLM). Mantenha false até o fluxo estar pronto.
NEXT_PUBLIC_AI_WRITING_ASSISTANT=false
# Limite de fotos por cartinha.
NEXT_PUBLIC_MAX_CART_PHOTOS=6

# Planos (preços em centavos). Autoritativos no servidor; os NEXT_PUBLIC_
# equivalentes são só para exibição no cliente (fallback dos acima).
PLAN_LIMITED_PRICE=1890
PLAN_PERMANENT_PRICE=4890
PLAN_LIMITED_DURATION_DAYS=365
NEXT_PUBLIC_PLAN_LIMITED_PRICE=1890
NEXT_PUBLIC_PLAN_PERMANENT_PRICE=4890
NEXT_PUBLIC_PLAN_LIMITED_DURATION_DAYS=365

# ---------------------------------------------------------------------------
# Banco de dados (Prisma + PostgreSQL via Supabase)
# ---------------------------------------------------------------------------

# Valores padrão do Supabase LOCAL (npx supabase start). Sem pooler
# localmente: DIRECT_URL repete DATABASE_URL. Em produção (Vercel), use as
# conexões do projeto remoto (pooler transaction-mode em DATABASE_URL,
# conexão direta/session-mode em DIRECT_URL).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Confirmação explícita exigida para o Prisma CLI (migrate/db push/studio)
# operar quando APP_ENV=production — proteção contra rodar comando de
# desenvolvimento sem querer no banco remoto (ver src/lib/appEnv.ts).
# Deixe em false/ausente em desenvolvimento.
ALLOW_PRISMA_CLI_PRODUCTION=false

# ---------------------------------------------------------------------------
# Supabase (projeto local ou remoto)
# ---------------------------------------------------------------------------

# URL do projeto. Local: http://127.0.0.1:54321 (npx supabase start).
# Produção: https://<projeto>.supabase.co (Dashboard > Project Settings > API).
SUPABASE_URL=http://127.0.0.1:54321

# Chave service_role. SOMENTE no servidor — NUNCA prefixo NEXT_PUBLIC_, nunca
# commitar o valor real de produção. A chave abaixo é a chave de DEMONSTRAÇÃO
# fixa do Supabase CLI (a mesma em qualquer instalação local, documentada
# publicamente — não é secreta). Em produção, troque pela service_role real
# do projeto (Dashboard > Project Settings > API) e nunca a versione.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

SUPABASE_STORAGE_BUCKET=cart-media

# ---------------------------------------------------------------------------
# Storage de fotos
# ---------------------------------------------------------------------------

# "supabase" (padrão, local e produção) → Supabase Storage.
# "local"    → disco (.data/uploads), servido por /api/media. Só para testes
#              isolados sem Docker — não sobrevive a deploy serverless.
STORAGE_PROVIDER=supabase
STORAGE_DIR=.data/uploads
STORAGE_PUBLIC_URL=/api/media

# ---------------------------------------------------------------------------
# Busca de música (YouTube)
# ---------------------------------------------------------------------------

# Modo: mock (demonstração, sem chave) | real (usa a API) | disabled (só colar link).
YOUTUBE_SEARCH_MODE=mock
# Habilita/desabilita a busca no servidor (false força "disabled").
YOUTUBE_SEARCH_ENABLED=true
# Máximo de resultados (1 a 8).
YOUTUBE_SEARCH_MAX_RESULTS=6
# TTL do cache em memória por termo, em segundos.
YOUTUBE_SEARCH_CACHE_TTL_SECONDS=3600
# Chave da YouTube Data API v3. SOMENTE no servidor — NUNCA prefixo NEXT_PUBLIC_.
# Necessária apenas no modo "real". Não commite a chave real.
YOUTUBE_API_KEY=
# Espelho de UI (mostrar/ocultar a aba de busca). Deve casar com YOUTUBE_SEARCH_ENABLED.
NEXT_PUBLIC_YOUTUBE_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# Pagamento (mock — pagamento real é Fase 3, fora do escopo desta fase)
# ---------------------------------------------------------------------------

# "mock" é o único modo suportado nesta fase. A confirmação mock exige o
# opt-in explícito abaixo (evita habilitar sem querer em produção).
PAYMENT_MODE=mock
ALLOW_MOCK_PAYMENT_CONFIRMATION=true
# Espelho de UI (texto exibido no checkout). Deve casar com PAYMENT_MODE.
NEXT_PUBLIC_PAYMENT_MODE=mock
# Espelho de UI (mostra/oculta o painel "simular pagamento" no checkout).
# Deve casar com ALLOW_MOCK_PAYMENT_CONFIRMATION. Padrão false (fail-closed):
# em produção, NÃO defina esta variável — sem ela, o checkout mostra a
# mensagem "pagamento indisponível" em vez do botão de simulação.
NEXT_PUBLIC_ALLOW_MOCK_PAYMENT_CONFIRMATION=true

# ---------------------------------------------------------------------------
# E-mail (mock — e-mail transacional real é Fase 3, fora do escopo desta fase)
# ---------------------------------------------------------------------------

EMAIL_MODE=mock
# Habilita a rota de desenvolvimento GET /api/dev/emails. Bloqueada em
# produção independentemente desta flag (checa NODE_ENV).
DEV_EMAILS_ENABLED=true

# ---------------------------------------------------------------------------
# Observabilidade (Sentry) — opcional, plano gratuito
# ---------------------------------------------------------------------------

# Ausente/vazio = Sentry desligado, a aplicação funciona normalmente.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Analytics — opcional, plano gratuito/cookieless
# ---------------------------------------------------------------------------

# Ausente/vazio = analytics desligado, a aplicação funciona normalmente.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# ---------------------------------------------------------------------------
# Flags de desenvolvimento
# ---------------------------------------------------------------------------

# NODE_ENV é definido automaticamente pelo Next.js (dev/build/start) — não
# defina manualmente aqui. Nenhuma flag de desenvolvimento adicional nesta
# fase além das já listadas acima (DEV_EMAILS_ENABLED, ALLOW_MOCK_PAYMENT_*).
